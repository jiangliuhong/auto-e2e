{
  "name": "@jarome/auto-e2e",
  "version": "0.3.0",
  "description": "基于 BetterWright 的本地需求验收、proof 与历史报告 CLI",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "bin": {
    "auto-e2e": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "postinstall": "node scripts/patch-betterwright.mjs",
    "patch:betterwright": "node scripts/patch-betterwright.mjs",
    "build": "node scripts/build.mjs",
    "link": "npm run build && npm link",
    "unlink": "npm unlink -g auto-e2e",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc -p tsconfig.json --noEmit",
    "publish:npm": "bash scripts/publish-npm.sh"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "dependencies": {
    "betterwright": "1.10.2",
    "commander": "^12.1.0",
    "yaml": "^2.6.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "files": [
    "dist",
    "skills",
    "scripts/patch-betterwright.mjs",
    "README.md"
  ]
}
